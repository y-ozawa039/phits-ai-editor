{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PHITS AI Editor",
  "version": "0.0.1-alpha",
  "identifier": "local.phits-ai-editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "PHITS AI Editor", "width": 1440, "height": 900, "minWidth": 1000, "minHeight": 650, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["inp", "pht"],
        "name": "PHITS input file",
        "role": "Editor"
      }
    ]
  }
}
