{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PHITS AI Editor",
  "version": "0.1.0-alpha.1",
  "identifier": "local.phits-ai-editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "PHITS AI Editor", "width": 1440, "height": 900, "minWidth": 1000, "minHeight": 650, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["nsis", "deb"], "createUpdaterArtifacts": false, "icon": [] }
}

